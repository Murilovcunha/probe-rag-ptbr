# Copie este arquivo para .env e ajuste.
#   cp .env.exemplo .env

# Onde o cache de pesos do Hugging Face sera gravado no host.
# Precisa de ~320 GB livres (secao 1 e 3.2 do README).
# ATENCAO: caminho ABSOLUTO e EXISTENTE. Se a pasta nao existir, o Docker
# a cria como root e o conteiner nao consegue escrever nela.
DIR_HF_HOST=/caminho/para/hf

# Onde a pasta saidas/ do experimento sera gravada no host.
DIR_SAIDAS_HOST=/caminho/para/saidas

# UID/GID do seu usuario, para que os arquivos gerados nao fiquem do root.
# NAO chute: rode  id -u  e  id -g  e use os valores reais.
HOST_UID=1000
HOST_GID=1000

# Token do Hugging Face (repositorios gated: gemma, medgemma, mistral).
# Deixe vazio se preferir autenticar com `hf auth login` dentro do conteiner.
HF_TOKEN=

# Onde o entregar.sh monta as pastas de entrega (<rotulo>_<commit>).
# Opcional: sem isto, ele usa uma pasta irma de DIR_SAIDAS_HOST.
DIR_ENTREGAS_HOST=/caminho/para/entregas
